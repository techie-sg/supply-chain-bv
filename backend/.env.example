# Copy this file to .env and replace the connection details for your database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dispatchdesk

# RAG assistant (Jina embeddings and OpenRouter LLM; storage uses DATABASE_URL above).
JINA_API_KEY=
OPENROUTER_KEY=

# Application JSON logging verbosity.
LOG_LEVEL=INFO

# Optional Langfuse tracing. Use keys and base URL from the same project/region.
# Restart the app after changing these values. Missing keys disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
# Set false to keep prompts, answers and tool content out of traces.
LANGFUSE_CAPTURE_CONTENT=true
# LANGFUSE_TRACING_ENABLED=false

# Provider and strategy selection. Fixed-size chunk lengths are characters.
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v5-text-nano
EMBEDDING_TASK_ADAPTERS=false
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Default fallback: nvidia/nemotron-3.5-lightning:free. Set [] to disable.
# OPENROUTER_FALLBACK_MODELS=["nvidia/nemotron-3.5-lightning:free"]
CHUNKING_STRATEGY=markdown_sections
CHUNK_SIZE=1600
CHUNK_OVERLAP=200

# Testing aid: every alert uses this cooldown in minutes instead of its own
# (10/15/60 by default). Leave unset in production.
# ALERT_COOLDOWN_OVERRIDE_MIN=2
