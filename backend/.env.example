# Copy this file to .env and replace the connection details for your database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dispatchdesk

# RAG assistant (Jina embeddings and Groq LLM; storage uses DATABASE_URL above).
JINA_API_KEY=
GROQ_API_KEY=

# Application JSON logging verbosity.
LOG_LEVEL=INFO

# Provider and strategy selection. Fixed-size chunk lengths are characters.
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v5-text-nano
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
CHUNKING_STRATEGY=markdown_sections
CHUNK_SIZE=1600
CHUNK_OVERLAP=200
