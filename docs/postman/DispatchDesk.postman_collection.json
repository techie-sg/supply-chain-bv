{
  "info": {
    "name": "DispatchDesk API",
    "description": "DispatchDesk production API. Change the base_url collection variable to target another environment. Scenario load requests replace operational rows; they have no request body. No authentication is currently required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://supply-chain-bv-production.up.railway.app",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/plain"
          }
        ],
        "url": "{{base_url}}/",
        "description": "Returns Hello, World! when the service is running."
      },
      "response": []
    },
    {
      "name": "List scenarios",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/scenarios",
        "description": "Lists available scenario keys and titles."
      },
      "response": []
    },
    {
      "name": "Normal",
      "item": [
        {
          "name": "Load normal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/scenarios/normal/load",
            "description": "Replaces the current orders, riders, zones, and hourly metrics with the normal scenario. Send no request body. Returns scenario context with timestamps and row counts."
          },
          "response": []
        },
        {
          "name": "Download normal XLSX",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
              }
            ],
            "url": "{{base_url}}/api/scenarios/normal/download",
            "description": "Downloads normal.xlsx with zones, riders, orders, and hourly_metrics sheets. Use Postman Send and Download to save the workbook. Does not change the database."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Backlog",
      "item": [
        {
          "name": "Load backlog",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/scenarios/backlog/load",
            "description": "Replaces the current orders, riders, zones, and hourly metrics with the backlog scenario. Send no request body. Returns scenario context with timestamps and row counts."
          },
          "response": []
        },
        {
          "name": "Download backlog XLSX",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
              }
            ],
            "url": "{{base_url}}/api/scenarios/backlog/download",
            "description": "Downloads backlog.xlsx with zones, riders, orders, and hourly_metrics sheets. Use Postman Send and Download to save the workbook. Does not change the database."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Rain",
      "item": [
        {
          "name": "Load rain",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/scenarios/rain/load",
            "description": "Replaces the current orders, riders, zones, and hourly metrics with the rain scenario. Send no request body. Returns scenario context with timestamps and row counts."
          },
          "response": []
        },
        {
          "name": "Download rain XLSX",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
              }
            ],
            "url": "{{base_url}}/api/scenarios/rain/download",
            "description": "Downloads rain.xlsx with zones, riders, orders, and hourly_metrics sheets. Use Postman Send and Download to save the workbook. Does not change the database."
          },
          "response": []
        }
      ]
    }
  ]
}
